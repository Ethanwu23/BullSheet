# ============================================================
# US Market Daily Xiaohongshu — 环境变量示例
# 复制为 .env 后填写；.env 已在 .gitignore 中，切勿提交真实值。
# ============================================================

# ---------- LLM Provider（模块 C）----------
# 可选值：rule_based（默认，无需 key）| dashscope（阿里百炼）|
#         openai_compatible（OpenAI / DeepSeek / OpenRouter / Moonshot / Groq …）| anthropic
LLM_PROVIDER=rule_based

# 通用 OpenAI 兼容端点（provider=openai_compatible 时生效）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000
# 生成一篇完整复盘实测约 30-60s（qwen3.8-flash，关闭思考链）；开启思考链可能需要 120s+
LLM_TIMEOUT_SECONDS=180

# --- 阿里百炼（DashScope）专用 ---
# 用法：LLM_PROVIDER=dashscope + DASHSCOPE_API_KEY=sk-xxx 即可，无需再写端点与模型
#   端点自动为 https://dashscope.aliyuncs.com/compatible-mode/v1
#   模型自动为 qwen3.8-flash（可用 LLM_MODEL 覆盖：qwen3.8-max / qwen3.8-27b …）
#   实测 2026-10-27 该端点返回 182 个 model id；用 `usmarket llm-models` 查看当前 key 可用列表
DASHSCOPE_API_KEY=
# 可选：关闭思考链可显著降低延迟与 token 消耗（模型默认开启思考）。
# 注意该参数仅百炼支持，其他 provider 请勿设置。
# LLM_EXTRA_BODY_JSON={"chat_template_kwargs": {"enable_thinking": false}}

# Anthropic（当 LLM_PROVIDER=anthropic 时使用）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---------- 行情数据源（模块 B）----------
# 可选值：yahoo | finnhub | alphavantage | mock
MARKET_PROVIDER=yahoo
# Finnhub 免费档不支持原始指数代码（^GSPC/^IXIC/^DJI），未配置时自动回退 yahoo
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
# 行情新鲜度阈值（分钟），超过则标记 STALE
MARKET_STALE_MINUTES=60

# ---------- 新闻采集（模块 A）----------
# SEC EDGAR 要求声明式 User-Agent：应用名/版本 (联系邮箱)
SEC_USER_AGENT="USMarketDailyXHS/0.1 (your-email@example.com)"
# 新闻回看窗口（小时）
NEWS_LOOKBACK_HOURS=48
# 自定义股票列表（逗号分隔），留空则使用 config/default.yaml
USMARKET_TICKERS=
# 网络请求超时（秒）
HTTP_TIMEOUT_SECONDS=15

# ---------- 发布（模块 E）----------
# 可选值：mock（默认，模拟）| manual_export（导出人工发布包）| browser（默认禁用，未验收）
XHS_PUBLISHER=mock
# 仅当 XHS_PUBLISHER=browser 且明确同意后才生效；本项目不实现任何反检测/验证码绕过
XHS_ENABLE_BROWSER=false
# 模拟发布注入失败（测试用）："1" 表示第一次调用失败
XHS_MOCK_FAIL_FIRST=0
# 重试配置
PUBLISH_MAX_RETRIES=3
PUBLISH_BACKOFF_SECONDS=1

# ---------- 运行模式 ----------
# offline=1 时使用 tests/fixtures 下的样本数据，不访问网络
USMARKET_OFFLINE=0
# 产物根目录
USMARKET_DATA_DIR=data
# 日志级别
LOG_LEVEL=INFO
